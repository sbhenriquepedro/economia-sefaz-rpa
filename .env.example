# URL do gerenciador de certificados PFX
API_PFX_MANAGER="http://SEU_ENDPOINT_AQUI"

# Usuário de autenticação (ex: CPF ou outro identificador)
USER="SEU_USUARIO_AQUI"

# Senha de autenticação
PASSWORD="SUA_SENHA_AQUI"

# Pasta onde os XMLs de entrada da rota automática serão salvos
FOLDER_TO_SAVE_XMLs_ROT_AUT_ENTRY="CAMINHO_PARA_PASTA_DE_SAIDA"

# Pasta onde os XMLs de saída da rota automática serão lidos
FOLDER_TO_SAVE_XMLs_ROT_AUT_OUT="CAMINHO_PARA_PASTA_DE_ENTRADA"
